{
  "protocol": "emotiontalk_multimodal_external_v1",
  "scope": "Frozen EmotionTalk text/audio/video external confirmation; train-only cross-fitting and calibration; one validation evaluation; test sealed",
  "frozen_on": "2026-08-07",
  "modality_subsets": {
    "text": ["text"],
    "text_audio": ["text", "audio"],
    "text_video": ["text", "video"],
    "text_audio_video": ["text", "audio", "video"]
  },
  "primary_base": "text_audio_video",
  "seeds": [17, 29, 43, 71, 101],
  "risk_seeds": [17, 29, 43, 71, 101],
  "crossfit_folds": 5,
  "selector_calibration_fraction": 0.20,
  "risk_quantile": 0.90,
  "vectorizer": {
    "analyzer": "char",
    "ngram_range": [2, 5],
    "min_df": 2,
    "max_df": 0.995,
    "max_features": 25000,
    "sublinear_tf": true
  },
  "media_projection": {
    "audio_components": 96,
    "video_components": 96,
    "svd_solver": "randomized",
    "iterated_power": 3,
    "row_l2_normalize": true
  },
  "classifier": {
    "loss": "log_loss",
    "penalty": "l2",
    "alpha": 0.00001,
    "class_weight": "balanced",
    "average": true,
    "max_iter": 1500,
    "tol": 0.0001
  },
  "risk_model": {
    "learning_rate": 0.05,
    "max_iter": 200,
    "max_leaf_nodes": 15,
    "min_samples_leaf": 30,
    "l2_regularization": 0.1
  },
  "negative_control": {
    "draws": 20,
    "seed": 20260807,
    "count_bins": [1, 2, 3, 5, 9]
  },
  "risk_curve_coverages": [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50, 0.60, 0.75, 0.90],
  "ece_bins": 15,
  "bootstrap_replicates": 2000,
  "bootstrap_seed": 20260807,
  "gates": {
    "natural_harm": {
      "min_harm_rate": 0.20,
      "min_harm_rate_ci_low": 0.10
    },
    "multimodal_selector_increment": {
      "min_all_harm_auc": 0.65,
      "min_auc_increment_vs_text": 0.02,
      "min_spearman_increment_vs_text": 0.03,
      "min_auc_increment_ci_low": 0.0,
      "min_spearman_increment_ci_low": 0.0
    },
    "strict_q90_fallback": {
      "min_history_coverage": 0.10,
      "max_policy_mean_excess_ci_high": 0.0,
      "min_harm_rate_reduction_among_used": 0.05
    },
    "pairing_specificity": {
      "min_actual_advantage_ci_low_nats": 0.0
    }
  },
  "sealed_split": "test_corpus",
  "validation_policy": "Validation labels may be opened exactly once after train-only tests, bundle creation, and freeze-manifest hash attestation. No threshold, representation, or gate may be changed afterward."
}
