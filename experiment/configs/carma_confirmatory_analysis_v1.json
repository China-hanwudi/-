{
  "analysis_id": "carma_confirmatory_analysis_v1",
  "schema_version": "1.0.0",
  "status": "frozen_design_not_yet_executed",
  "frozen_on": "2026-08-08",
  "pre_execution_amendment": {
    "amended_on": "2026-08-08",
    "reason": "align confirmatory contract with independently audited shared-cluster inference, mandatory accuracy no-harm, and the strongest observed admissible baseline before any sealed role is opened",
    "results_visible_before_amendment": false
  },
  "split_manifest": "carma_split_manifest_v1.json",
  "split_protocol_id": "scu_set_exploration_v1",
  "claim_boundary": "Confirmatory performance claim only; model-relative history utility is not a causal psychological effect",
  "required_confirmatory_datasets": [
    "MELD",
    "EmotionTalk"
  ],
  "optional_replication_datasets": [
    "IEMOCAP"
  ],
  "independent_runs": {
    "seeds": [
      17,
      29,
      43,
      71,
      101
    ],
    "required_seed_count": 5,
    "independence_unit": "full_training_run",
    "each_seed_reinitializes": [
      "model_parameters",
      "optimizer_state",
      "minibatch_order",
      "counterfactual_subset_sampling"
    ],
    "shared_across_seeds": [
      "frozen_group_role_assignment",
      "feature_schema",
      "primary_operating_point",
      "metric_and_contrast_definitions"
    ]
  },
  "primary_operating_point": {
    "mode": "fixed_target_history_coverage",
    "primary_history_coverages": [
      0.25
    ],
    "target_was_fixed_before_calibration_unseal": true,
    "calibration_rule": {
      "role": "calibration",
      "rule": "choose_the_threshold_with_absolute_empirical_history_coverage_closest_to_0.25",
      "tie_break_order": [
        "lower_cluster_bootstrap_mean_regret_upper_bound",
        "lower_threshold_numeric_value",
        "stable_candidate_id"
      ],
      "no_admissible_threshold": "method_failure_current_only_fallback_for_deployment_without_success_claim",
      "selected_threshold_is_hashed_before_holdout": true
    },
    "secondary_coverage_curve": {
      "coverages": [
        0.1,
        0.5
      ],
      "purpose": "descriptive_sensitivity_only",
      "may_determine_success": false
    },
    "forbidden_success_rules": [
      "at_least_one_coverage_passes",
      "best_posthoc_coverage_passes",
      "dataset_specific_primary_coverage",
      "test_selected_threshold"
    ]
  },
  "primary_contrasts": [
    {
      "contrast_id": "carma_bidirectional_vs_frozen_strongest_admissible_baseline",
      "candidate": "carma_bidirectional_full",
      "reference": "strongest_admissible_baseline_frozen_on_model_selection",
      "reference_candidates": [
        "current_only",
        "all_history",
        "coverage_matched_recency",
        "forward_only_utility",
        "backward_only_utility"
      ],
      "reference_selection_rule": "highest_five_seed_mean_model_selection_macro_f1_then_highest_accuracy_then_lowest_mean_regret_then_lexicographic_model_id",
      "reference_is_frozen_before_calibration_unseal": true,
      "pairing": "same_dataset_groups_seed_and_primary_operating_point"
    }
  ],
  "metrics": {
    "primary_classification": {
      "name": "macro_f1",
      "aggregation": "compute_from_pooled_out_of_group_predictions_with_dataset_balanced_summary",
      "direction": "higher_is_better"
    },
    "primary_safety": {
      "name": "mean_regret",
      "definition": "mean_nll_selected_history_minus_current_only_on_history_eligible_queries",
      "direction": "lower_is_better"
    },
    "mandatory_secondary": [
      "accuracy",
      "weighted_f1",
      "history_harm_rate",
      "p90_regret",
      "cvar90_regret",
      "brier",
      "ece",
      "realized_history_coverage"
    ]
  },
  "effect_and_safety_gates": {
    "minimum_macro_f1_gain_absolute": 0.005,
    "macro_f1_gain_ci95_lower_must_exceed": 0.0,
    "absolute_mean_regret_vs_current_ci95_upper_must_not_exceed": 0.0,
    "mean_regret_difference_vs_frozen_reference_ci95_upper_must_not_exceed": 0.0,
    "minimum_relative_history_harm_rate_reduction": 0.05,
    "accuracy_no_harm": {
      "gate_id": "carma_confirmatory_accuracy_no_harm_v1",
      "required_references": [
        "current_only",
        "strongest_admissible_baseline_frozen_on_model_selection"
      ],
      "contrasts": [
        {
          "id": "A1_accuracy_vs_current",
          "candidate": "carma_bidirectional_full",
          "reference": "current_only"
        },
        {
          "id": "A2_accuracy_vs_frozen_reference",
          "candidate": "carma_bidirectional_full",
          "reference": "strongest_admissible_baseline_frozen_on_model_selection"
        }
      ],
      "minimum_point_difference": 0.0,
      "minimum_ci95_lower": -0.005,
      "interpretation": "minus_0.005_is_a_noninferiority_no_harm_margin_not_evidence_of_improvement"
    },
    "required_datasets_passing": 2,
    "required_seed_successes_per_dataset": 4,
    "success_quantifier": "all_required_datasets_at_the_single_primary_operating_point",
    "classification_and_safety_must_both_pass": true,
    "classification_safety_and_accuracy_no_harm_must_all_pass": true
  },
  "mde_and_power": {
    "target_metric": "macro_f1",
    "minimum_detectable_gain_absolute": 0.005,
    "minimum_power": 0.8,
    "two_sided_alpha": 0.05,
    "power_assessment_roles": [
      "base_and_utility_fit",
      "model_selection"
    ],
    "calibration_holdout_or_test_rows_for_power": "forbidden",
    "insufficient_power_action": "do_not_unseal_calibration_holdout_or_external_test_and_report_underpowered_design"
  },
  "hierarchical_bootstrap": {
    "replicates": 10000,
    "bootstrap_seed": 20260808,
    "paired": true,
    "confidence_level": 0.95,
    "interval": "percentile",
    "dataset_aggregation": "equal_weight_required_datasets_after_within_dataset_estimation",
    "bootstrap_design": "five_training_seeds_crossed_with_shared_whole_cluster_draw",
    "resampling_hierarchy": [
      "dataset_specific_independent_cluster_shared_across_training_seeds",
      "training_seed_crossed_not_nested"
    ],
    "shared_cluster_draw_across_training_seeds": true,
    "candidate_and_reference_share_seed_and_cluster_draws": true,
    "cluster_units": {
      "MELD": "Dialogue_ID",
      "EmotionTalk": "dialogue_or_official_group_id",
      "IEMOCAP": "session_then_dialogue_id"
    },
    "keep_all_queries_within_resampled_cluster": true,
    "independent_query_row_bootstrap": false
  },
  "hypothesis_testing": {
    "method": "paired_whole_cluster_randomization",
    "monte_carlo_assignments": 10000,
    "randomization_seed": 20260829,
    "exact_enumeration_max_clusters": 16,
    "cluster_swap_shared_across_training_seeds": true,
    "nonlinear_metrics_recomputed_per_assignment": true,
    "bootstrap_tail_probability_may_be_used_as_p_value": false
  },
  "holm_family": {
    "family_id": "carma_confirmatory_claim_family_v1",
    "method": "holm_bonferroni",
    "familywise_alpha": 0.05,
    "directional_tests_are_prespecified": true,
    "hypotheses": [
      {
        "id": "H1_primary_macro_f1",
        "contrast": "carma_bidirectional_vs_frozen_strongest_admissible_baseline",
        "metric": "macro_f1",
        "alternative": "greater"
      },
      {
        "id": "H2_primary_mean_regret",
        "contrast": "carma_bidirectional_full_vs_current_only",
        "metric": "mean_regret",
        "alternative": "less"
      },
      {
        "id": "H3_emotion_constraint_increment",
        "contrast": "carma_bidirectional_full_vs_without_emotion_constraints",
        "metric": "macro_f1",
        "alternative": "greater"
      },
      {
        "id": "H4_three_by_three_relation_increment",
        "contrast": "carma_bidirectional_full_vs_without_3x3_relations",
        "metric": "macro_f1",
        "alternative": "greater"
      },
      {
        "id": "H5_current_only_increment",
        "contrast": "carma_bidirectional_full_vs_current_only",
        "metric": "macro_f1",
        "alternative": "greater"
      }
    ],
    "method_success_requires_adjusted_rejection_of": [
      "H1_primary_macro_f1",
      "H2_primary_mean_regret"
    ],
    "family_is_frozen_before_holdout_unseal": true,
    "unlisted_inferential_claims": "exploratory_only"
  },
  "sealing_and_stage_order": {
    "ordered_stages": [
      "fit_and_crossfit",
      "model_selection_and_reference_freeze",
      "analysis_code_config_and_environment_hash_freeze",
      "calibration_single_threshold_once",
      "calibration_artifact_hash_freeze",
      "internal_holdout_one_shot",
      "external_test_one_shot_after_authorized_unseal"
    ],
    "calibration_sealed_before_model_and_analysis_freeze": true,
    "internal_holdout_sealed_before_calibration_artifact_freeze": true,
    "external_test_sealed_before_complete_bundle_freeze": true,
    "test_labels_may_change_model_threshold_or_claim_family": false,
    "one_shot_outputs_are_write_once": true,
    "failed_internal_holdout_action": "do_not_open_external_test_for_method_success_claim"
  },
  "failure_criteria": {
    "method_success_is_false_if_any": [
      "macro_f1_gain_below_0.005_on_either_required_dataset",
      "macro_f1_gain_ci95_lower_not_above_zero_on_either_required_dataset",
      "absolute_mean_regret_vs_current_ci95_upper_above_zero_on_either_required_dataset",
      "mean_regret_difference_vs_frozen_reference_ci95_upper_above_zero_on_either_required_dataset",
      "accuracy_point_difference_below_zero_vs_current_or_frozen_reference_on_either_required_dataset",
      "accuracy_ci95_lower_below_minus_0.005_vs_current_or_frozen_reference_on_either_required_dataset",
      "relative_history_harm_rate_reduction_below_0.05_on_either_required_dataset",
      "fewer_than_four_of_five_seed_runs_succeed_on_either_required_dataset",
      "holm_adjusted_primary_family_requirement_fails",
      "split_role_or_seal_violation",
      "only_a_secondary_coverage_passes"
    ],
    "failure_route": "report_negative_or_underpowered_result_without_method_success_claim_and_keep_unopened_splits_sealed",
    "all_prespecified_results_must_be_reported": true
  }
}
