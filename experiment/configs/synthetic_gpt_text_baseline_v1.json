      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicted_emotion",
        "probabilities",
        "history_effect",
        "vad"
      ],
      "properties": {
        "predicted_emotion": {
          "type": "string",
          "enum": [
            "anger",
            "disgust",
            "fear",
            "joy",
            "neutral",
            "sadness",
            "surprise"
          ]
        },
        "probabilities": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "history_effect": {
          "type": "string",
          "enum": [
            "beneficial",
            "harmful",
            "uncertain"
          ]
        },
        "vad": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -1.0,
            "maximum": 1.0
          }
        }
      }
    },
    "response_schema_sha256": "bf1b979433a75927ebbfc7e63be6bcb26895835437659ee98d7bcd25a99c93a8"
  },
  "context_contract": {
    "accepted_fixture_schema": "carma_explicit_synthetic_text_fixture_v1",
    "current_text_required": true,
    "history_semantics": "strict_past_only_oldest_to_newest",
    "max_records": 256,
    "max_current_characters": 512,
    "max_history_items": 8,
    "max_history_item_characters": 512,
