{
  "protocol": "emotiontalk_scu_endpoint_diagnostic_v1",
  "dataset": "emotiontalk",
  "role_protocol": "scu_set_exploration_v1",
  "scope": "Train-only endpoint diagnostic before stochastic history-subset augmentation",
  "primary_modalities": ["text", "audio", "video"],
  "crossfit_folds": 5,
  "base_seeds": [17, 29, 43, 71, 101],
  "risk_seeds": [17, 29, 43, 71, 101],
  "coverages": [0.10, 0.25, 0.50],
  "bootstrap_replicates": 2000,
  "bootstrap_seed": 20260807,
  "roles": {
    "base_and_utility_fit": [0, 64],
    "model_selection": [65, 79],
    "calibration": [80, 89],
    "internal_holdout_sealed": [90, 99]
  },
  "gates": {
    "minimum_model_selection_history_queries": 300,
    "minimum_model_selection_clusters": 30,
    "minimum_mean_score_spearman": 0.10,
    "minimum_harm_probability_auc": 0.55,
    "minimum_pairwise_seed_target_spearman": 0.40,
    "minimum_majority_sign_agreement": 0.65,
    "maximum_selected_set_jaccard_for_reversal": 0.80,
    "minimum_mean_regret_advantage_for_reversal": 0.01,
    "minimum_harm_rate_advantage_for_reversal": 0.03,
    "minimum_reversal_coverages": 1
  },
  "decision_rule": "Proceed to stochastic subset augmentation only if sample size, cross-seed target stability, both predictive signals, and at least one sign-severity preference reversal all pass on model_selection.",
  "sealed_policy": {
    "calibration_targets_read": false,
    "internal_holdout_targets_read": false,
    "validation_targets_read": false,
    "test_targets_read": false
  }
}
