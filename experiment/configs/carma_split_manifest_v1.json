{
  "manifest_id": "carma_split_manifest_v1",
  "schema_version": "1.0.0",
  "status": "frozen_before_confirmatory_runs",
  "frozen_on": "2026-08-08",
  "split_protocol_id": "scu_set_exploration_v1",
  "assignment": {
    "unit": "dataset_scoped_dialogue_or_session_or_speaker_group",
    "digest": "sha256",
    "canonical_message": "utf8(dataset_id + unit_separator + group_id + unit_separator + split_protocol_id)",
    "bucket_rule": "first_8_digest_bytes_as_unsigned_big_endian_integer_modulo_100",
    "hash_inputs": [
      "dataset_id",
      "group_id",
      "split_protocol_id"
    ],
    "forbidden_hash_inputs": [
      "model_protocol_id",
      "candidate_model_id",
      "coverage",
      "threshold",
      "seed",
      "hyperparameters",
      "labels"
    ],
    "role_assignment_locked": true,
    "group_never_crosses_roles": true,
    "missing_group_policy": "fail_closed"
  },
  "roles": {
    "base_and_utility_fit": {
      "bucket_range_inclusive": [
        0,
        64
      ],
      "label_state": "open_for_train_only_model_fitting",
      "allowed_uses": [
        "base_model_cross_fit",
        "utility_target_generation",
        "candidate_model_fit"
      ],
      "forbidden_uses": [
        "confirmatory_claim",
        "calibration_threshold_selection"
      ]
    },
    "model_selection": {
      "bucket_range_inclusive": [
        65,
        79
      ],
      "label_state": "open_for_exploratory_model_selection_only",
      "allowed_uses": [
        "architecture_selection",
        "hyperparameter_selection",
        "single_direction_reference_selection",
        "preflight_power_estimation"
      ],
      "forbidden_uses": [
        "final_effect_claim",
        "post_calibration_model_change"
      ]
    },
    "calibration": {
      "bucket_range_inclusive": [
        80,
        89
      ],
      "label_state": "sealed_until_model_contrast_metrics_and_primary_operating_point_are_frozen",
      "allowed_uses_after_unseal": [
        "single_prespecified_threshold_calibration",
        "probability_calibration"
      ],
      "forbidden_uses": [
        "model_selection",
        "coverage_target_selection",
        "effect_claim",
        "training_row_reuse"
      ]
    },
    "internal_holdout": {
      "bucket_range_inclusive": [
        90,
        99
      ],
      "label_state": "sealed_until_calibration_artifact_is_frozen_and_hashed",
      "allowed_uses_after_unseal": [
        "one_shot_internal_confirmation"
      ],
      "forbidden_uses": [
        "model_selection",
        "threshold_selection",
        "repeated_peeking",
        "training_row_reuse"
      ]
    }
  },
  "external_test_policy": {
    "label_state": "sealed_until_complete_analysis_bundle_is_frozen_and_hashed",
    "access_mode": "one_shot_write_once_aggregate_report",
    "model_or_threshold_change_after_access": "forbidden",
    "per_query_output_export": "forbidden"
  },
  "datasets": {
    "MELD": {
      "group_key": "Dialogue_ID",
      "exploratory_status": "train_and_dev_evidence_already_explored",
      "confirmatory_split": "official_test",
      "confirmatory_status": "sealed_unopened",
      "license_and_access": "researcher_managed_under_upstream_terms_not_redistributed",
      "raw_data_in_repository": false
    },
    "EmotionTalk": {
      "group_key": "dialogue_or_official_group_id",
      "exploratory_status": "validation_opened_once_for_prior_frozen_external_analysis",
      "confirmatory_split": "official_test",
      "confirmatory_status": "sealed_unopened",
      "license_and_access": "researcher_managed_under_upstream_terms_not_redistributed",
      "raw_data_in_repository": false
    },
    "IEMOCAP": {
      "group_key": "session_and_dialogue_id",
      "exploratory_status": "not_started",
      "confirmatory_split": "session_disjoint_split_to_be_frozen_before_any_access",
      "confirmatory_status": "ineligible_until_license_verified_and_session_disjoint_manifest_frozen",
      "license_and_access": "restricted_license_not_verified_in_public_repository",
      "raw_data_in_repository": false
    }
  },
  "privacy_boundary": {
    "repository_allowed": [
      "source_code_and_contract_tests",
      "frozen_configuration",
      "non_reidentifying_aggregate_metrics_and_confidence_intervals",
      "synthetic_test_fixtures"
    ],
    "repository_forbidden": [
      "raw_or_redistributed_text_labels_audio_or_video",
      "speaker_dialogue_or_query_keys",
      "media_paths_or_transcript_tables",
      "per_query_predictions_or_utilities",
      "derived_audio_or_video_embeddings",
      "model_weights_checkpoints_or_training_bundles",
      "license_forms_ethics_material_or_authorization_messages",
      "tokens_passwords_cookies_or_private_environment_files"
    ],
    "external_llm_api": {
      "raw_or_row_level_restricted_dataset_content": "forbidden",
      "allowed_payloads": [
        "public_dataset_schema",
        "non_reidentifying_aggregate_statistics",
        "synthetic_examples"
      ],
      "exception_policy": "requires_separate_license_privacy_and_data_processing_approval_before_manifest_revision"
    }
  },
  "drift_policy": {
    "role_reassignment_after_freeze": "forbidden",
    "new_model_protocol_reuses_same_role_map": true,
    "manifest_change_requires_new_split_protocol_id": true,
    "old_and_new_protocol_results_must_not_be_pooled": true
  }
}
