{
  "protocol": "emotiontalk_point_risk_v1",
  "scope": "EmotionTalk text-only point-utility tail-risk MVP; train cross-fit; validation evaluation; test sealed",
  "seeds": [17, 29, 43, 71, 101],
  "crossfit_folds": 5,
  "selector_calibration_fraction": 0.20,
  "risk_quantile": 0.90,
  "vectorizer": {
    "analyzer": "char",
    "ngram_range": [2, 5],
    "min_df": 2,
    "max_df": 0.995,
    "max_features": 25000,
    "sublinear_tf": true
  },
  "classifier": {
    "loss": "log_loss",
    "penalty": "l2",
    "alpha": 0.00001,
    "class_weight": "balanced",
    "average": true,
    "max_iter": 1500,
    "tol": 0.0001
  },
  "risk_model": {
    "learning_rate": 0.05,
    "max_iter": 200,
    "max_leaf_nodes": 15,
    "min_samples_leaf": 30,
    "l2_regularization": 0.1
  },
  "ece_bins": 15,
  "bootstrap_replicates": 2000,
  "bootstrap_seed": 20260805,
  "go_gate": {
    "min_history_coverage": 0.10,
    "max_mean_excess_ci_high": 0.0,
    "min_harm_reduction_vs_always_history": 0.05
  }
}
