{
  "protocol": "bidirectional_emotion_utility_v1",
  "status": "frozen_train_only_exploration_contract_not_yet_run",
  "research_claim": "Emotion-theory-constrained, different-set bidirectional marginal utility for calibrated reversible multimodal history selection",
  "data_roles": {
    "unit": "dialogue_or_dataset_group",
    "assignment": "sha256(dataset, group, split_protocol_id) modulo 100",
    "split_protocol_id": "scu_set_exploration_v1",
    "base_and_utility_fit": [0, 64],
    "model_selection": [65, 79],
    "calibration": [80, 89],
    "internal_holdout_sealed": [90, 99],
    "external_test": "sealed_until_method_and_thresholds_are_frozen"
  },
  "datasets": {
    "primary_exploration": ["EmotionTalk_train_roles", "MELD_train_roles"],
    "planned_confirmation": ["MELD_test", "EmotionTalk_test", "IEMOCAP_if_license_allows"],
    "minimum_confirmation_datasets": 2
  },
  "six_streams": {
    "current": ["text", "audio", "video"],
    "history": ["text_history", "audio_history", "video_history"],
    "strict_temporal_rule": "history_timestamp_or_turn_index_must_be_less_than_query",
    "shared_projection_dimension": 128,
    "relation_grid": "3_current_modalities_x_3_history_modalities",
    "relation_features_per_pair": ["cosine", "l2", "signed_mean_delta"]
  },
  "emotion_domain_constraints": {
    "theory_features": ["VAD_state", "VAD_transition", "emotion_shift_probability", "CPM_or_appraisal_state_if_available"],
    "frozen_text_encoder_candidate": "EmoBERTa_or_existing_text_encoder_with_equal_cost_baseline",
    "frozen_audio_encoder_candidate": "emotion2vec_or_existing_WavLM_assets",
    "frozen_video_features": "AU_or_expression_features_or_existing_DINOv2_assets",
    "download_policy": "reuse_existing_assets_first_no_large_unplanned_downloads",
    "gold_emotion_in_features": false
  },
  "nontrivial_bidirectional_utility": {
    "sign_convention": "benefit_positive",
    "forward_addition": "u_plus = loss(S) - loss(S_union_candidate)",
    "backward_deletion": "u_minus = loss(T_without_candidate) - loss(T)",
    "mandatory_constraint": "T != S_union_candidate",
    "supervision": "train_only_out_of_fold_predictions",
    "targets": ["u_plus", "u_minus", "u_plus_minus_u_minus", "sign_agreement", "harm_probability", "quantiles_10_50_90"],
    "claim_boundary": "model_relative_decision_utility_not_psychological_causal_effect"
  },
  "counterfactual_sampling": {
    "draws_per_query": 8,
    "maximum_candidates_per_query": 20,
    "minimum_history_candidates": 2,
    "seed": 20260808,
    "match_context_cardinality": true,
    "candidate_policy": "strict_past_with_deterministic_recent_plus_reservoir_cap",
    "forbidden": ["future_turns", "query_group_training_rows", "validation_or_test_labels", "gold_history_emotion"]
  },
  "base_subset_augmentation": {
    "maximum_contexts_per_query": 8,
    "include_current_only_and_full_history": true,
    "query_balanced_sample_weight": true,
    "seed": 20260808
  },
  "model_comparison": {
    "mandatory_baselines": [
      "current_only",
      "all_history",
      "recency_top_k",
      "similarity_top_k",
      "forward_only_utility",
      "backward_only_utility",
      "six_stream_without_emotion_constraints",
      "emotion_constraints_without_bidirectionality",
      "bidirectional_without_3x3_relations",
      "rcps_or_conformal_fallback_baseline"
    ],
    "primary": "small_bidirectional_set_conditioned_model_under_2m_parameters",
    "selection": "reversible_query_level_selection_with_current_only_fallback"
  },
  "metrics": {
    "classification_primary": "macro_f1",
    "classification_secondary": ["accuracy", "weighted_f1"],
    "safety_primary": ["history_harm_rate", "mean_regret", "p90_regret", "cvar90_regret", "risk_coverage"],
    "calibration": ["brier", "ece", "coverage_error"],
    "statistics": ["five_seeds", "dialogue_or_speaker_cluster_bootstrap", "paired_effect_size", "holm_correction"]
  },
  "train_only_go_gate": {
    "bidirectional_beats_forward_only": true,
    "bidirectional_beats_backward_only": true,
    "minimum_macro_f1_gain": 0.002,
    "minimum_harm_rate_relative_reduction": 0.05,
    "maximum_mean_regret_ci95_high": 0.0,
    "minimum_nontrivial_coverage": 0.1,
    "minimum_successful_seeds_out_of_five": 4
  },
  "confirmatory_go_gate": {
    "minimum_datasets_passing": 2,
    "must_improve_classification_and_safety": true,
    "must_beat_strongest_single_direction_baseline": true,
    "failure_route": "publish_negative_transfer_benchmark_or_negative_result_without_method_success_claim"
  }
}
