{
  "protocol": "scu_set_exploration_v1",
  "status": "proposal_not_yet_validated",
  "scope": "Train-only stochastic counterfactual utility set learning for reversible history selection",
  "data_roles": {
    "unit": "dialogue_or_dataset_group",
    "assignment": "sha256(dataset, group, protocol) modulo 100",
    "base_and_utility_fit": [0, 64],
    "model_selection": [65, 79],
    "calibration": [80, 89],
    "internal_holdout_sealed": [90, 99]
  },
  "base_crossfit": {
    "folds": 5,
    "seeds": [17, 29, 43, 71, 101],
    "history_dropout": true,
    "forbidden": [
      "query-group training rows",
      "future turns",
      "history gold emotion",
      "validation or test labels"
    ]
  },
  "counterfactual_sampling": {
    "subset_draws_per_query": 4,
    "maximum_candidates_per_query": 20,
    "candidate_policy": "all strict-past candidates up to cap; deterministic recency reservoir beyond cap",
    "subset_cardinality": "uniform from zero to available-minus-one",
    "sampling_seed": 20260807,
    "interaction_probe_pairs_per_query": 2
  },
  "utility_targets": {
    "definition": "NLL(with candidate added) - NLL(without candidate)",
    "quantiles": [0.10, 0.50, 0.90],
    "auxiliary": ["harm_sign", "pairwise_ranking"],
    "claim": "model-relative conditional decision utility, not causal psychological effect"
  },
  "utility_model_candidates": {
    "linear_baseline": {
      "type": "regularized linear quantile/classification heads"
    },
    "primary": {
      "type": "small set-conditioned MLP",
      "hidden_dimensions": [128, 128],
      "dropout": 0.10,
      "maximum_parameters": 2000000
    }
  },
  "selection": {
    "mode": "sequential reversible query-level selection",
    "maximum_selected": 10,
    "risk_rule": "cluster-calibrated q90 upper bound below zero",
    "fallback": "current-only when no candidate passes",
    "coverage_constraints": [0.10, 0.25, 0.50]
  },
  "exploration_gates": {
    "minimum_harm_auc_gain_vs_recency_similarity": 0.02,
    "minimum_spearman_gain_vs_recency_similarity": 0.03,
    "maximum_mean_policy_regret_ci95_high": 0.0,
    "minimum_nontrivial_coverage": 0.10,
    "minimum_harm_rate_reduction_vs_always_history": 0.05,
    "minimum_cross_seed_successes_out_of_five": 4
  },
  "gpt": {
    "enabled": false,
    "reason": "No authorized API credential in the current environment",
    "allowed_future_roles": ["frozen zero-shot baseline", "frozen feature teacher", "distillation teacher"],
    "forbidden": ["test-label prompt tuning", "future context", "raw audio/video upload", "uncached nondeterministic confirmation"]
  }
}
